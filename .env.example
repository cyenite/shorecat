SHORECAT_IMAGE=ghcr.io/cyenite/shorecat:0.1.0
SHORECAT_PUBLIC_URL=https://updates.example.com
COMPOSE_FILE=compose.yaml:compose.https.yaml

# Optional: otherwise a random token is persisted in the data volume.
# SHORECAT_ADMIN_TOKEN=

# The host port is for local access or an existing reverse proxy.
SHORECAT_BIND_ADDRESS=127.0.0.1
SHORECAT_PORT=8787
